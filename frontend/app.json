{
  "expo": {
    "name": "ST Paisios",
    "slug": "st-paisios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "supportsRTL": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.cesarfreij.stpaisios"
    },
    "web": {
      "bundler": "metro",
      "name": "ST Paisios",
      "shortName": "Paisios",
      "display": "standalone",
      "orientation": "portrait",
      "backgroundColor": "#ffffff",
      "themeColor": "#000000",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "owner": "cesarfreij",
    "extra": {
      "eas": {
        "projectId": "ab217d90-d381-40ee-8463-5534b1511130"
      }
    }
  }
}
